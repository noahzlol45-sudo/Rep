-- Helper function to generate premium-looking buttons
local function createButton(name, text, layoutOrder, callback)
    local Button = Instance.new("TextButton")
    local BtnCorner = Instance.new("UICorner")
    local BtnStroke = Instance.new("UIStroke")
    
    Button.Name = name
    Button.Parent = MainFrame
    Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Button.Size = UDim2.new(0, 210, 0, 42)
    Button.LayoutOrder = layoutOrder
    Button.Font = Enum.Font.GothamSemibold
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(220, 220, 220)
    Button.TextSize = 14
    Button.AutoButtonColor = false
    
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Button
    
    BtnStroke.Color = Color3.fromRGB(50, 50, 55)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = Button

    -- Hover and Click Animations
    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        BtnStroke.Color = Color3.fromRGB(180, 0, 0)
        Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    
    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        BtnStroke.Color = Color3.fromRGB(50, 50, 55)
        Button.TextColor3 = Color3.fromRGB(220, 220, 220)
    end)
    
    Button.MouseButton1Down:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
    end)

    Button.MouseButton1Up:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        callback()
    end)
end

