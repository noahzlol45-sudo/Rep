-- Find F3X Remote Function automatically
local F3XRemote = game:GetService("ReplicatedStorage"):FindFirstChild("SyncAPI") and game:GetService("ReplicatedStorage").SyncAPI:FindFirstChild("ServerEndpoint")

if not F3XRemote then
    warn("F3X SyncAPI ServerEndpoint not found in ReplicatedStorage!")
end

local DECAL_ID = "108090882481963"

-- 1. Decal Spam Button
createButton("DecalSpam", "🔥 Decal Spam", 1, function()
    if not F3XRemote then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            -- F3X tool texture creation format
            pcall(function()
                F3XRemote:InvokeServer("CreateTextures", {obj}, "Decal")
                -- Standard F3X updates faces for created textures across all 6 sides
                local faces = {Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Front, Enum.NormalId.Back}
                for _, face in ipairs(faces) do
                    -- Attempts to find created texture/decal to change texture ID
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("Decal") and child.Texture == "" then
                            F3XRemote:InvokeServer("EditTexture", {child}, {
                                Texture = "rbxassetid://" .. DECAL_ID,
                                Face = face
                            })
                        end
                    end
                end
            end)
        end
    end
end)

